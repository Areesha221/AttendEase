# Copy this file to `.env.local` and adjust as needed.

# Secret used to sign the session cookie. Set a long random string in real use.
# SESSION_SECRET=change-me-to-a-long-random-string

# Show the demo login hints (welcome page + login "Fill" buttons).
# Default: shown. Set to false before a real presentation/deployment,
# then rebuild with `npm run build` (values are baked in at build time).
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
