# ============================================================
# Copy this file to `.env.local` for local development, or add
# the same keys in Vercel -> Settings -> Environment Variables.
# NEVER commit `.env.local` or real tokens to Git.
# ============================================================

# ---- Turso (production / cloud database) ----
# Create a database at https://turso.tech, then copy its URL and token.
# Local development does NOT need these: it uses data/attendance.db.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-database-token

# ---- Session secret (required in production) ----
# Long random string used to sign the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET=replace-with-a-long-random-string

# ---- Optional: override the local SQLite file ----
# ATTENDANCE_DB_URL=file:data/attendance.db
